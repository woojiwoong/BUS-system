        function parseTxtData(text, fileName = "") {
            const lines = text.split(/\r?\n/);
            let currentSection = null;
            let newRoutes = {};
            let newSpares = [];
            let newOffDays = {};
            // TXT로 저장된 수동 배차변경/휴무표시 변경도 함께 복원합니다.
            let newManualOverrides = {};
            let newManualOffDisplayOverrides = {};
            let detectedMonth = currentMonth;
            let detectedYear = currentYear;
            let dateDetected = false;

            // 파일명/내용의 실제 날짜(YYYY-MM-DD 또는 YY-MM-DD)를 기준으로 월을 감지합니다.
            const detectDate = (value) => {
                if (!value) return;
                let match = value.match(/(20\d{2})[-\/.](0?[1-9]|1[0-2])[-\/.](0?[1-9]|[12]\d|3[01])/);
                if (match) {
                    detectedYear = parseInt(match[1], 10);
                    detectedMonth = parseInt(match[2], 10);
                    dateDetected = true;
                    return;
                }
                match = value.match(/(\d{2})[-\/.](0?[1-9]|1[0-2])[-\/.](0?[1-9]|[12]\d|3[01])/);
                if (match) {
                    detectedYear = 2000 + parseInt(match[1], 10);
                    detectedMonth = parseInt(match[2], 10);
                    dateDetected = true;
                }
            };

            // 예: 대호_배차_2026-09.txt, 26-09-01.txt
            detectDate(fileName);

            lines.forEach(line => {
                let trimmed = line.trim();
                if (!trimmed) return;

                // TXT 안의 실제 날짜를 감지합니다. (예: 26-09-01)
                detectDate(trimmed);

                const yearMatch = trimmed.match(/(20\d{2})\s*년?/);
                if (yearMatch) detectedYear = parseInt(yearMatch[1], 10);

                // 실제 날짜가 없을 때만 '9월', '10월' 표기를 보조적으로 사용합니다.
                if (!dateDetected) {
                    for (let m = 1; m <= 12; m++) {
                        if (trimmed.includes(`${m}월`) || trimmed.includes(`${m} 월`)) {
                            detectedMonth = m;
                            break;
                        }
                    }
                }
                if (trimmed.startsWith('[')) {
                    const match = trimmed.match(/\[(.*?)\]/);
                    if (match) {
                        currentSection = match[1].trim();
                        if (currentSection !== '스페어' && !newRoutes[currentSection]) newRoutes[currentSection] = [];
                    }
                    return;
                }
                if (trimmed.includes('직원 일자별 휴일자 명단') || trimmed.includes('휴일자')) { currentSection = 'OFFDAYS'; return; }

                if (currentSection === '배차현황' || currentSection === '수동배차변경') {
                    // 형식: YY-MM-DD|노선|차량|오전: 기사|오후: 기사
                    // [배차현황]은 '그 날짜에 실제 화면에 표시된 최종 배차'를 전부 저장합니다.
                    // 따라서 변경된 차량뿐 아니라 변경되지 않은 차량도 함께 저장되어,
                    // TXT를 다시 불러오면 저장 당시의 배차 상태가 그대로 복원됩니다.
                    const parts = trimmed.split('|').map(v => v.trim());
                    if (parts.length >= 4) {
                        const dateKey = parts[0];
                        const routeName = parts[1];
                        const busNo = parts[2];
                        const overrideKey = `${dateKey}_${routeName}_${busNo}`;
                        const obj = {};
                        parts.slice(3).forEach(part => {
                            const m = part.match(/^(오전|오후)\s*:\s*(.*)$/);
                            if (!m) return;
                            const shift = m[1] === '오전' ? 'morning' : 'afternoon';
                            const name = m[2].trim().replace('(S)', '');
                            if (name) obj[shift] = name;
                        });
                        if (Object.keys(obj).length) newManualOverrides[overrideKey] = obj;
                    }
                } else if (currentSection === '수동휴무표시') {
                    // 형식: YY-MM-DD: 기사1,기사2,...
                    if (trimmed.includes(':')) {
                        const idx = trimmed.indexOf(':');
                        const dateKey = trimmed.slice(0, idx).trim();
                        const namesStr = trimmed.slice(idx + 1).trim();
                        newManualOffDisplayOverrides[dateKey] = namesStr
                            ? namesStr.split(',').map(n => n.trim().replace('(S)','')).filter(Boolean)
                            : [];
                    }
                }

                if (currentSection === 'OFFDAYS') {
                    if (trimmed.includes(':')) {
                        const [dateStr, namesStr] = trimmed.split(':');
                        const dMatch = dateStr.trim().match(/(\d+)/g);
                        if (dMatch && dMatch.length >= 1) {
                            let dayStr = parseInt(dMatch[dMatch.length - 1], 10) < 10 ? `0${parseInt(dMatch[dMatch.length - 1], 10)}` : `${parseInt(dMatch[dMatch.length - 1], 10)}`;
                            let monthStr = detectedMonth < 10 ? `0${detectedMonth}` : `${detectedMonth}`;
                            let dateKey = `${String(detectedYear).substring(2)}-${monthStr}-${dayStr}`;
                            newOffDays[dateKey] = namesStr ? namesStr.split(',').map(n => n.trim().replace('(S)','')).filter(Boolean) : [];
                        }
                    }
                } else if (currentSection === '스페어' || currentSection === '스페어기사') {
                    newSpares.push(...trimmed.split(',').map(n => n.trim().replace('(S)','')).filter(Boolean));
                } else if (currentSection && currentSection.includes('번')) {
                    if (trimmed.includes(':')) {
                        const [busNo, driversStr] = trimmed.split(':');
                        newRoutes[currentSection].push({ busNo: busNo.trim(), drivers: driversStr.split(',').map(d => d.trim().replace('(S)','')).filter(Boolean) });
                    }
                }
            });
            currentYear = detectedYear;
            currentMonth = detectedMonth;

            // TXT 파일을 불러오면 해당 TXT 데이터의 1일을
            // 일자별배차현황 조회일자의 기본값으로 적용합니다.
            selectedDailyDate = `${currentYear}-${String(currentMonth).padStart(2, '0')}-01`;

            if (Object.keys(newRoutes).length > 0) appData.routes = newRoutes;
            if (newSpares.length > 0) appData.spares = newSpares;
            if (Object.keys(newOffDays).length > 0) appData.offDays = newOffDays;
            manualOverrides = newManualOverrides;
            manualOffDisplayOverrides = newManualOffDisplayOverrides;
        }

        function isSunday(dateKey, targetYear = null) {
            const parts = dateKey.split('-');
            const year = targetYear || currentYear;
            return new Date(year, parseInt(parts[1], 10) - 1, parseInt(parts[2], 10)).getDay() === 0;
        }

        // 월별 배차 계산 결과를 연/월별로 따로 보관합니다.
        // 일자별 배차현황에서 조회일자를 바꾸어도 다른 월의 계산 결과가 섞이지 않습니다.
        let monthlySimulationCache = null;
        let monthlySimulationCacheKey = '';
        function runMonthlySpareSimulation(targetYear = currentYear, targetMonth = currentMonth) {
            const cacheKey = `${targetYear}-${String(targetMonth).padStart(2, '0')}`;
            if (monthlySimulationCache && monthlySimulationCacheKey === cacheKey) return monthlySimulationCache;

            let spareShift = {}, spareWasOffYesterday = {};
            appData.spares.forEach(s => { spareShift[s] = '오전'; spareWasOffYesterday[s] = false; });
            let dailySimResults = {}, totalDays = getDaysInMonth(targetYear, targetMonth), yyStr = String(targetYear).substring(2);

            for (let d = 1; d <= totalDays; d++) {
                const dayStr = d < 10 ? `0${d}` : `${d}`, mStr = targetMonth < 10 ? `0${targetMonth}` : `${targetMonth}`;
                const dateKey = `${yyStr}-${mStr}-${dayStr}`;
                // 자동 배차 계산의 휴무 기준은 원본 휴무데이터를 사용합니다.
                // 기사변경으로 휴무자 표시가 바뀌어도 다른 차량의 기존 배차까지
                // 연쇄적으로 바뀌지 않도록 합니다.
                const baseOffList = [...(appData.offDays[dateKey] || [])]
                    .map(n => String(n).replace('(S)', '').trim()).filter(Boolean);
                let offList = [...baseOffList];
                const isSun = isSunday(dateKey, targetYear);

                appData.spares.forEach(s => {
                    if (!offList.includes(s) && spareWasOffYesterday[s]) {
                        spareShift[s] = (spareShift[s] === '오전') ? '오후' : '오전';
                        spareWasOffYesterday[s] = false;
                    }
                });
                appData.spares.forEach(s => { if (offList.includes(s)) spareWasOffYesterday[s] = true; });

                let availableSpares = shuffleArrayWithSeed(appData.spares.filter(s => !offList.includes(s)), d * 123);
                let morningSpares = [], afternoonSpares = [];
                availableSpares.forEach(s => { if (spareShift[s] === '오전') morningSpares.push(s); else afternoonSpares.push(s); });

                let sundaySwaps = 0;
                for (let i = 1; i <= d; i++) {
                    let testKey = `${yyStr}-${mStr}-${i < 10 ? '0' + i : i}`;
                    if (isSunday(testKey, targetYear)) sundaySwaps++;
                }
                const isSwapped = (sundaySwaps % 2 !== 0);

                let busAssignments = [], assignedSpares = [];
                Object.keys(appData.routes).forEach(routeName => {
                    appData.routes[routeName].forEach(bus => {
                        let base1 = bus.drivers[0] || "미정", base2 = bus.drivers[1] || "미정";
                        let mReg = !isSwapped ? base1 : base2, aReg = !isSwapped ? base2 : base1;
                        let mOff = offList.includes(mReg), aOff = offList.includes(aReg);
                        let mAssigned = "", aAssigned = "";

                        if (mOff && aOff && isSun) {
                            mAssigned = "운행종료"; aAssigned = "운행종료";
                        } else {
                            mAssigned = !mOff ? mReg : (morningSpares.shift() || afternoonSpares.shift() || (isSun ? "운행종료" : "운행종료"));
                            
                            aAssigned = !aOff ? aReg : (afternoonSpares.shift() || morningSpares.shift() || (isSun ? "운행종료" : "운행종료"));
                        }

                        const overrideKey = `${dateKey}_${routeName}_${bus.busNo}`;
                        if (manualOverrides[overrideKey]) {
                            if (manualOverrides[overrideKey].morning !== undefined) mAssigned = manualOverrides[overrideKey].morning;
                            if (manualOverrides[overrideKey].afternoon !== undefined) aAssigned = manualOverrides[overrideKey].afternoon;
                        }

                        // 최종 배차 결과를 기준으로 스페어 투입차량을 기록합니다.
                        // 기사변경 모달에서 수동으로 스페어를 넣은 경우에도
                        // 화면의 「스페어 대체 투입」 차량과 실제 배차표가 반드시 일치합니다.
                        const cleanM = String(mAssigned || '').replace('(S)', '').trim();
                        const cleanA = String(aAssigned || '').replace('(S)', '').trim();
                        const isSpareName = name => appData.spares.some(s => s.replace('(S)', '').trim() === name);
                        if (isSpareName(cleanM)) assignedSpares.push({ spare: cleanM, busNo: bus.busNo, line: routeName, shift: '오전' });
                        if (isSpareName(cleanA)) assignedSpares.push({ spare: cleanA, busNo: bus.busNo, line: routeName, shift: '오후' });

                        busAssignments.push({ line: routeName, busNo: bus.busNo, morningRegular: mReg, afternoonRegular: aReg, morningAssigned: mAssigned, afternoonAssigned: aAssigned, morningIsOff: mOff, afternoonIsOff: aOff });
                    });
                });
                // 화면의 「오늘의 휴무기사」는 기사변경에서 교체한 휴무상태를 표시합니다.
                // 단, 이 표시 변경 때문에 다른 차량의 자동배차는 다시 계산하지 않습니다.
                const displayOffList = manualOffDisplayOverrides[dateKey]
                    ? [...manualOffDisplayOverrides[dateKey]]
                    : [...baseOffList];
                dailySimResults[dateKey] = { offList: displayOffList, busAssignments, assignedSpares };
            }
            monthlySimulationCache = dailySimResults;
            monthlySimulationCacheKey = cacheKey;
            return monthlySimulationCache;
        }

        function getDailyAssignment(dateKey) {
            // dateKey 자체의 연/월을 사용해 해당 날짜의 월간 배차 데이터를 계산합니다.
            // 전역 currentYear/currentMonth에 의존하지 않아 조회일자와 실제 데이터가 어긋나지 않습니다.
            const parts = String(dateKey || '').split('-');
            let targetYear = currentYear;
            let targetMonth = currentMonth;
            if (parts.length === 3 && /^\d{2}$/.test(parts[0]) && /^\d{2}$/.test(parts[1])) {
                targetYear = 2000 + parseInt(parts[0], 10);
                targetMonth = parseInt(parts[1], 10);
            }
            return runMonthlySpareSimulation(targetYear, targetMonth)[dateKey] || { offList: [], busAssignments: [], assignedSpares: [] };
        }

        let currentEditingCell = null;
        function openDriverSelectModal(dateKey, line, busNo, shift, currentVal) {
            currentEditingCell = { dateKey, line, busNo, shift };
            document.getElementById('selectModalTitle').innerText = `${dateKey} (${line} ${busNo}) - 기사 변경`;

            let allDrivers = [];
            Object.keys(appData.routes).forEach(r => appData.routes[r].forEach(b => b.drivers.forEach(d => {
                if (!allDrivers.includes(d)) allDrivers.push(d);
            })));
            appData.spares.forEach(s => {
                if (!allDrivers.includes(s)) allDrivers.push(s);
            });

            const dayData = getDailyAssignment(dateKey);
            const offList = dayData.offList || [];

            // 현재 차량의 오전/오후 기사가 같은 사람인 경우에는
            // 휴무자 또는 휴무 스페어를 선택하지 못하게 합니다.
            const currentBusForModal = (dayData.busAssignments || []).find(
                b => b.line === line && b.busNo === busNo
            );
            const morningDriver = currentBusForModal
                ? String(currentBusForModal.morningAssigned || '').replace('(S)', '').trim()
                : '';
            const afternoonDriver = currentBusForModal
                ? String(currentBusForModal.afternoonAssigned || '').replace('(S)', '').trim()
                : '';
            const sameMorningAfternoonDriver =
                morningDriver && afternoonDriver && morningDriver === afternoonDriver;

            // 현재 선택한 근무자가 반대 교대(오전↔오후)에도 배차되어 있는지 확인합니다.
            // 이 경우에만 휴무자/휴무 스페어를 기사변경 모달에서 선택할 수 없게 합니다.
            const selectedShiftDriver = shift === 'morning' ? morningDriver : afternoonDriver;
            const oppositeShift = shift === 'morning' ? 'afternoonAssigned' : 'morningAssigned';
            const currentDriverInOppositeShift = selectedShiftDriver &&
                (dayData.busAssignments || []).some(b => {
                    const assigned = String(b[oppositeShift] || '').replace('(S)', '').trim();
                    return assigned === selectedShiftDriver;
                });
            // 운행종료/운행종료 상태의 셀은 휴무자 및 휴무 스페어도
            // 자유롭게 선택할 수 있도록 합니다. 그 외 기존 제한 규칙은 그대로 유지합니다.
            const isPlaceholderDriver = selectedShiftDriver === '운행종료' || selectedShiftDriver === '운행종료';
            const blockOffDrivers = !!currentDriverInOppositeShift && !isPlaceholderDriver;

            allDrivers.sort((a, b) => {
                let aOff = offList.includes(a) ? 0 : 1;
                let bOff = offList.includes(b) ? 0 : 1;
                return aOff - bOff;
            });

            let listHtml = `<button onclick="selectDriverForCell('운행종료')" class="w-full text-left px-3 py-2 rounded-lg bg-rose-50 hover:bg-rose-100 text-rose-800 font-bold text-xs flex items-center justify-between mb-1"><span>운행종료 (차량 운휴)</span></button>`;

            allDrivers.forEach(name => {
                let isOff = offList.includes(name);
                let isSpare = appData.spares.includes(name);
                const cleanName = String(name || '').replace('(S)', '').trim();

                // 현재 기사 자체가 반대 교대에도 배차되어 있으면 휴무자/휴무 스페어를 선택할 수 없습니다.
                // 반대 교대에 배차되어 있지 않다면 휴무자도 기존 규칙에 따라 선택할 수 있습니다.
                const blocked = false;

                let statusText = isOff ? "휴무" : "근무중";
                if (isSpare) statusText += " (스페어)";
                
                let statusBadgeClass = isOff ? "bg-rose-100 text-rose-700 font-bold" : "bg-emerald-100 text-emerald-700";
                listHtml += `
                    <button onclick="selectDriverForCell('${name}')" class="w-full text-left px-3 py-2 rounded-lg ${isOff ? 'bg-rose-50/50 hover:bg-rose-100/60 border border-rose-100' : 'bg-slate-50 hover:bg-slate-100'} text-slate-800 text-xs flex items-center justify-between transition-colors">
                        <span class="font-bold text-slate-950 ${isSpare ? 'text-blue-600 blue-underline' : ''}">${name}</span>
                        <span class="px-2 py-0.5 rounded-full text-[10px] ${statusBadgeClass}">${statusText}</span>
                    </button>
                `;
            });

            document.getElementById('driverSelectList').innerHTML = listHtml;
            document.getElementById('driverSelectModal').classList.remove('hidden');
        }

        function closeDriverSelectModal() { document.getElementById('driverSelectModal').classList.add('hidden'); currentEditingCell = null; }
        function selectDriverForCell(selectedName) {
            if (!currentEditingCell) return;

            const { dateKey, line, busNo, shift } = currentEditingCell;
            const overrideKey = `${dateKey}_${line}_${busNo}`;
            // 대체미정은 운행종료로 통일
            const cleanSelectedName = String(selectedName || '')
                .replace('(S)', '').trim()
                .replace(/^대체미정$/, '운행종료');

            const dayDataBefore = getDailyAssignment(dateKey);
            const currentBus = (dayDataBefore.busAssignments || []).find(
                b => b.line === line && b.busNo === busNo
            );
            const currentDriver = currentBus
                ? String(shift === 'morning' ? currentBus.morningAssigned : currentBus.afternoonAssigned)
                    .replace('(S)', '').trim()
                    .replace(/^대체미정$/, '운행종료')
                : '';

            // ★ 같은 날짜의 같은 교대에 이미 배차된 기사만 중복 선택을 막습니다.
            // 휴무자는 선택할 수 있어야 하므로 휴무자 선택은 차단하지 않습니다.
            if (cleanSelectedName !== '운행종료' && cleanSelectedName) {
                const duplicateSameShiftBus = (dayDataBefore.busAssignments || []).find(b => {
                    if (b.line === line && b.busNo === busNo) return false;
                    const assigned = shift === 'morning' ? b.morningAssigned : b.afternoonAssigned;
                    return String(assigned || '').replace('(S)', '').trim().replace(/^대체미정$/, '운행종료') === cleanSelectedName;
                });

                if (duplicateSameShiftBus) {
                    showModal(
                        '근무 겹침',
                        `${dateKey} ${shift === 'morning' ? '오전' : '오후'}근무에 ${cleanSelectedName} 기사가 이미 배차되어 있습니다.\n\n같은 일자의 같은 근무시간에는 같은 기사를 중복 배차할 수 없습니다.`
                    );
                    return;
                }
            }

            if (!manualOverrides[overrideKey]) manualOverrides[overrideKey] = {};
            manualOverrides[overrideKey][shift] = cleanSelectedName;

            // ★ 핵심 규칙
            // 현재 기사가 오전/오후 양쪽에 배차되어 있으면 차량이 같든 달라도
            // 한쪽을 운행종료/다른 기사/휴무자로 변경할 때 기존 기사를 휴무자로 만들지 않습니다.
            const oppositeShiftField = shift === 'morning' ? 'afternoonAssigned' : 'morningAssigned';
            const currentDriverInOppositeShift = currentDriver &&
                currentDriver !== '운행종료' &&
                (dayDataBefore.busAssignments || []).some(b => {
                    const assigned = String(b[oppositeShiftField] || '')
                        .replace('(S)', '').trim()
                        .replace(/^대체미정$/, '운행종료');
                    return assigned === currentDriver;
                });

            if (currentDriver && currentDriver !== cleanSelectedName) {
                const currentOffList = (manualOffDisplayOverrides[dateKey]
                    ? [...manualOffDisplayOverrides[dateKey]]
                    : [...(appData.offDays[dateKey] || [])])
                    .map(n => String(n).replace('(S)', '').trim().replace(/^대체미정$/, '운행종료'))
                    .filter(n => n && n !== '운행종료');

                // ★ 핵심: 같은 이름의 기사가 오전/오후에 모두 근무 중이면
                // 차량이 같든 다른 차량이든 어떤 기사로 변경해도 기존 기사를 휴무자로 만들지 않습니다.
                // 운행종료로 변경하는 경우도 동일합니다.
                if (currentDriverInOppositeShift) {
                    // 같은 기사가 오전/오후(같은 차량 또는 다른 차량)에 모두 근무 중인 경우
                    // 기존 근무자는 반대 교대에서 계속 근무하므로 휴무자로 만들지 않습니다.
                    // 단, 선택한 기사가 기존 휴무자라면 그 기사는 근무로 전환되므로
                    // 오늘의 휴무자 목록에서는 반드시 제거합니다.
                    const selectedIsOff = currentOffList.includes(cleanSelectedName);
                    manualOffDisplayOverrides[dateKey] = selectedIsOff
                        ? currentOffList.filter(n => n !== cleanSelectedName && n !== '운행종료')
                        : currentOffList.filter(n => n !== '운행종료');
                } else if (cleanSelectedName === '운행종료') {
                    // 일반 근무자 -> 운행종료: 기존 기사는 휴무자로 표시합니다.
                    if (currentDriver !== '운행종료' && !currentOffList.includes(currentDriver)) {
                        currentOffList.push(currentDriver);
                    }
                    manualOffDisplayOverrides[dateKey] = currentOffList.filter(n => n !== '운행종료');
                } else {
                    const selectedIsOff = currentOffList.includes(cleanSelectedName);

                    if (selectedIsOff) {
                        // ★ 휴무자를 선택해서 근무자로 대체하는 경우
                        // 선택한 휴무자는 휴무명단에서 제거하고,
                        // 원래 근무자는 휴무자로 대체합니다.
                        const newOffList = currentOffList.filter(n => n !== cleanSelectedName);
                        if (currentDriver && currentDriver !== '운행종료' && !newOffList.includes(currentDriver)) {
                            newOffList.push(currentDriver);
                        }
                        manualOffDisplayOverrides[dateKey] = newOffList.filter(n => n !== '운행종료');
                    } else {
                        // 일반 근무자 → 다른 근무자 변경은 기존 규칙 유지:
                        // 기존 근무자를 휴무자로 대체합니다.
                        if (currentDriver !== '운행종료' && currentDriver && !currentOffList.includes(currentDriver)) {
                            currentOffList.push(currentDriver);
                        }
                        manualOffDisplayOverrides[dateKey] = currentOffList.filter(n => n !== '운행종료');
                    }
                }
            }

            // ★ 주별통합 탭에서 기사변경 후에도 사용자가 보고 있던 가로 스크롤 위치를 유지합니다.
            // 예: 9/9일을 보고 기사변경 → 확인해도 9/6일로 되돌아가지 않고 9/9일 위치를 그대로 유지합니다.
            const weeklyScrollState = Array.from(
                document.querySelectorAll('#view-weekly .overflow-x-auto')
            ).map(el => ({ scrollLeft: el.scrollLeft, scrollTop: el.scrollTop }));

            monthlySimulationCache = null;
            monthlySimulationCacheKey = '';
            closeDriverSelectModal();
            renderAllViews();

            // renderAllViews()로 주별통합 테이블이 다시 생성된 직후 기존 스크롤 위치 복원
            requestAnimationFrame(() => {
                const weeklyScrollEls = document.querySelectorAll('#view-weekly .overflow-x-auto');
                weeklyScrollState.forEach((state, index) => {
                    const el = weeklyScrollEls[index];
                    if (!el) return;
                    el.scrollLeft = state.scrollLeft;
                    el.scrollTop = state.scrollTop;
                });
            });

            showModal(
                '기사 변경 완료',
                cleanSelectedName === '운행종료'
                    ? '선택한 데이터 셀만 운행종료로 변경했습니다.'
                    : `${currentDriver || '기존기사'} → ${cleanSelectedName} 변경 완료.`
            );
        }

        function renderDailyView() {
            const picker = document.getElementById('dailyDatePicker');
            const dateInput = selectedDailyDate || (picker ? picker.value : '');
            if (!/^\d{4}-\d{2}-\d{2}$/.test(dateInput)) return;

            // 화면을 다시 그릴 때도 input의 날짜를 선택 상태와 일치시킵니다.
            if (picker && picker.value !== dateInput) picker.value = dateInput;

            // 선택한 날짜 자체를 데이터 조회 키로 사용합니다.
            // 여기서는 currentYear/currentMonth를 절대 변경하지 않습니다.
            const selectedDateKey = dateInput.substring(2);
            const data = getDailyAssignment(selectedDateKey);
            document.getElementById('dailyOffCount').innerText = `${data.offList.length}명`;
            document.getElementById('dailyOffList').innerHTML = data.offList.map(n => {
                let cleanN = n.replace('(S)','').trim();
                let isS = appData.spares.includes(cleanN);
                if (isS) {
                    return `<span class="inline-flex items-center gap-1 px-2 py-0.5 text-blue-600 font-bold blue-underline rounded text-xs"><i data-lucide="user-cog" class="w-3 h-3"></i>${cleanN}</span>`;
                }
                return `<span class="inline-flex items-center gap-1 px-2 py-0.5 bg-rose-100 text-rose-800 rounded text-xs"><i data-lucide="user-x" class="w-3 h-3"></i>${cleanN}</span>`;
            }).join('') || '<span class="inline-flex items-center gap-1 text-xs text-slate-400"><i data-lucide="check-circle" class="w-3 h-3"></i>휴무자 없음</span>';

            document.getElementById('dailySpareCount').innerText = `${data.assignedSpares.length}명`;
            document.getElementById('dailySpareList').innerHTML = data.assignedSpares.map(s => {
                let cleanSpare = s.spare.replace('(S)','').trim();
                return `<span class="inline-flex items-center gap-1 px-2 py-0.5 text-blue-600 font-bold rounded text-xs blue-underline"><i data-lucide="user-cog" class="w-3 h-3"></i>${cleanSpare} → ${s.busNo}</span>`;
            }).join('') || '<span class="inline-flex items-center gap-1 text-xs text-slate-400"><i data-lucide="minus-circle" class="w-3 h-3"></i>투입 없음</span>';

            // 정상 운행 차량 수 갱신
            const activeCount = (data.busAssignments || []).filter(b =>
                !String(b.morningAssigned || '').includes('운행종료') ||
                !String(b.afternoonAssigned || '').includes('운행종료')
            ).length;
            const activeEl = document.getElementById('dailyActiveBusCount');
            if (activeEl) activeEl.innerText = `${activeCount}대`;

