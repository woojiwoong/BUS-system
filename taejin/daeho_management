        function renderDriverWorkGraph() {
            const graphEl = document.getElementById('driverWorkGraph');
            const titleEl = document.getElementById('driverGraphMonthTitle');
            const totalEl = document.getElementById('driverGraphTotal');
            if (!graphEl) return;

            const totalDays = getDaysInMonth(currentYear, currentMonth);
            const names = [];
            Object.keys(appData.routes || {}).forEach(route => {
                (appData.routes[route] || []).forEach(bus => {
                    (bus.drivers || []).forEach(name => {
                        const clean = String(name || '').replace('(S)', '').trim();
                        if (clean && !names.includes(clean)) names.push(clean);
                    });
                });
            });
            (appData.spares || []).forEach(name => {
                const clean = String(name || '').replace('(S)', '').trim();
                if (clean && !names.includes(clean)) names.push(clean);
            });

            const workCounts = {};
            names.forEach(name => workCounts[name] = { morning: 0, afternoon: 0 });
            for (let d = 1; d <= totalDays; d++) {
                const dateKey = `${String(currentYear).substring(2)}-${String(currentMonth).padStart(2,'0')}-${String(d).padStart(2,'0')}`;
                const dayData = getDailyAssignment(dateKey);
                (dayData?.busAssignments || []).forEach(bus => {
                    const m = String(bus.morningAssigned || '').replace('(S)','').trim();
                    const a = String(bus.afternoonAssigned || '').replace('(S)','').trim();
                    if (workCounts[m]) workCounts[m].morning++;
                    if (workCounts[a]) workCounts[a].afternoon++;
                });
            }

            const entries = names.map(name => {
                const morning = workCounts[name]?.morning || 0;
                const afternoon = workCounts[name]?.afternoon || 0;
                const work = morning + afternoon;
                const off = Math.max(0, totalDays - work);
                return { name, morning, afternoon, off, work,
                    isSpare: (appData.spares || []).some(s => String(s).replace('(S)','').trim() === name) };
            }).sort((a,b) => Number(a.isSpare) - Number(b.isSpare) || a.name.localeCompare(b.name, 'ko'));

            const maxWork = Math.max(totalDays, 1);
            const yTicks = [0, Math.ceil(maxWork * 0.25), Math.ceil(maxWork * 0.5), Math.ceil(maxWork * 0.75), maxWork];
            const yAxis = yTicks.map(v => {
                const pct = 100 - (v / maxWork * 100);
                return `<span class="driver-work-yaxis-label" style="top:${pct}%">${v}</span>`;
            }).join('');

            const bars = entries.map(item => {
                const height = Math.max(0.7, (item.work / maxWork) * 100);
                const morningHeight = (item.morning / maxWork) * 100;
                const afternoonHeight = (item.afternoon / maxWork) * 100;
                const offHeight = (item.off / maxWork) * 100;
                const statusClass = item.work < 22 ? 'under22' : (item.isSpare ? 'spare' : '');
                return `<div class="driver-work-item">
                    <div class="driver-work-bar-wrap">
                        <div class="driver-work-bar-stack ${statusClass}" style="height:100%" data-driver-tooltip="${item.name}" data-morning="${item.morning}" data-afternoon="${item.afternoon}" data-off="${item.off}" data-work="${item.work}" role="button" tabindex="0" aria-label="${item.name}: 오전 ${item.morning}일, 오후 ${item.afternoon}일, 휴무 ${item.off}일, 근무합계 ${item.work}일">
                            ${item.off ? `<div class="driver-work-bar off" style="height:${offHeight}%"><span>${item.off}</span></div>` : ''}
                            ${item.afternoon ? `<div class="driver-work-bar afternoon" style="height:${afternoonHeight}%"><span>${item.afternoon}</span></div>` : ''}
                            ${item.morning ? `<div class="driver-work-bar morning" style="height:${morningHeight}%"><span>${item.morning}</span></div>` : ''}
                        </div>
                    </div>
                    <div class="driver-work-name ${item.isSpare ? 'spare' : ''}">${item.name}<span class="driver-work-total">(${item.work}일)</span></div>
                </div>`;
            }).join('');

            graphEl.innerHTML = `<div class="driver-work-yaxis"><div class="driver-work-axis-title">근무일수(일)</div>${yAxis}</div><div class="driver-work-plot"><div class="driver-work-bars" style="--driver-count:${Math.max(entries.length,1)}">${bars}</div></div><div class="driver-work-xaxis-title">근무기사(총근무일수)</div>`;
            if (titleEl) titleEl.textContent = `${currentYear}년 ${currentMonth}월`;
            if (totalEl) {
                const totalWork = entries.reduce((sum, item) => sum + item.work, 0);
                totalEl.textContent = `기사 ${entries.length}명 · 전체 근무 ${totalWork}회`;
            }

            graphEl.querySelectorAll('.driver-work-bar-stack').forEach(bar => {
                const showTip = (e) => {
                    e.stopPropagation();
                    let tip = document.getElementById('driverWorkTooltip');
                    if (window.driverTooltipTimer) clearTimeout(window.driverTooltipTimer);
                    if (!tip) { tip = document.createElement('div'); tip.id = 'driverWorkTooltip'; tip.className = 'driver-work-tooltip'; document.body.appendChild(tip); }
                    tip.innerHTML = `<b>${bar.dataset.driverTooltip}</b><span>🟧 오전 ${bar.dataset.morning}일</span><span>🟦 오후 ${bar.dataset.afternoon}일</span><span>⬜ 휴무 ${bar.dataset.off}일</span><strong>근무합계 ${bar.dataset.work}일</strong>`;
                    tip.style.display = 'flex';
                    const rect = bar.getBoundingClientRect();
                    const left = Math.max(8, Math.min(window.innerWidth - tip.offsetWidth - 8, rect.left + rect.width / 2 - tip.offsetWidth / 2));
                    const top = Math.max(8, rect.top - tip.offsetHeight - 8);
                    tip.style.left = `${left}px`; tip.style.top = `${top}px`;
                    window.driverTooltipTimer = setTimeout(() => {
                        tip.style.display = 'none';
                    }, 5000);
                };
                bar.addEventListener('mouseenter', showTip);
                bar.addEventListener('click', showTip);
                bar.addEventListener('touchstart', showTip, {passive:true});
                bar.addEventListener('focus', showTip);
                bar.addEventListener('keydown', e => { if (e.key === 'Enter' || e.key === ' ') showTip(e); });
            });
        }

