        // ==================== Android daeho 폴더 자동 이미지 저장 ====================
        // Android Chrome 등 File System Access API를 지원하는 브라우저에서는
        // 최초 1회만 "daeho" 폴더 사용 권한을 받고, 이후에는 같은 폴더에 자동 저장합니다.
        let androidDaehoDirHandle = null;
        const ANDROID_DAEHO_DB = 'daehoImageSaveDB';
        const ANDROID_DAEHO_STORE = 'handles';

        function isAndroidDevice() {
            return /android/i.test(navigator.userAgent || '');
        }

        function openAndroidHandleDB() {
            return new Promise((resolve, reject) => {
                const req = indexedDB.open(ANDROID_DAEHO_DB, 1);
                req.onupgradeneeded = () => {
                    const db = req.result;
                    if (!db.objectStoreNames.contains(ANDROID_DAEHO_STORE)) {
                        db.createObjectStore(ANDROID_DAEHO_STORE);
                    }
                };
                req.onsuccess = () => resolve(req.result);
                req.onerror = () => reject(req.error);
            });
        }

        async function loadAndroidDaehoHandle() {
            try {
                const db = await openAndroidHandleDB();
                return await new Promise((resolve, reject) => {
                    const tx = db.transaction(ANDROID_DAEHO_STORE, 'readonly');
                    const req = tx.objectStore(ANDROID_DAEHO_STORE).get('daehoDir');
                    req.onsuccess = () => resolve(req.result || null);
                    req.onerror = () => reject(req.error);
                });
            } catch (e) {
                return null;
            }
        }

        async function saveAndroidDaehoHandle(handle) {
            try {
                const db = await openAndroidHandleDB();
                await new Promise((resolve, reject) => {
                    const tx = db.transaction(ANDROID_DAEHO_STORE, 'readwrite');
                    tx.objectStore(ANDROID_DAEHO_STORE).put(handle, 'daehoDir');
                    tx.oncomplete = resolve;
                    tx.onerror = () => reject(tx.error);
                });
            } catch (e) {
                console.warn('daeho 폴더 권한 저장 실패:', e);
            }
        }

        async function getAndroidDaehoDirectory() {
            if (!('showDirectoryPicker' in window)) return null;

            // 메모리 → IndexedDB 순서로 기존 폴더 권한을 복원합니다.
            let handle = androidDaehoDirHandle || await loadAndroidDaehoHandle();

            if (handle) {
                try {
                    const permission = await handle.queryPermission({ mode: 'readwrite' });
                    if (permission === 'granted') {
                        androidDaehoDirHandle = handle;
                        return handle;
                    }
                    if (permission === 'prompt') {
                        const requested = await handle.requestPermission({ mode: 'readwrite' });
                        if (requested === 'granted') {
                            androidDaehoDirHandle = handle;
                            return handle;
                        }
                    }
                } catch (e) {
                    console.warn('기존 daeho 폴더 권한 확인 실패:', e);
                }
            }

            // 최초 1회: 사용자가 내장 저장공간의 daeho 폴더를 직접 선택합니다.
            try {
                handle = await window.showDirectoryPicker({ mode: 'readwrite' });
                if (!handle || handle.name.toLowerCase() !== 'daeho') {
                    showModal('폴더 확인', '이미지 저장 폴더는 반드시 "daeho" 폴더를 선택해 주세요.', true);
                    return null;
                }
                androidDaehoDirHandle = handle;
                await saveAndroidDaehoHandle(handle);
                return handle;
            } catch (e) {
                if (e && e.name === 'AbortError') return null;
                throw e;
            }
        }

