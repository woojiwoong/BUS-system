        function renderDriverStatsView() {
            // 기존 기사별 통계표는 제거하고, 날짜별 통합 근무통계만 표시합니다.
            monthlySimulationCache = null;
            monthlySimulationCacheKey = '';
            runMonthlySpareSimulation();

            const totalDays = getDaysInMonth(currentYear, currentMonth);
            const statsHead = document.getElementById('dailyShiftStatsHeader');
            const statsBody = document.getElementById('dailyShiftStatsBody');
            const totalEl = document.getElementById('dailyShiftStatsTotal');
            if (!statsHead || !statsBody) return;

            // 모든 정규기사 + 스페어를 한 사람당 한 행으로 구성합니다.
            const names = [];
            Object.keys(appData.routes || {}).forEach(route => {
                (appData.routes[route] || []).forEach(bus => {
                    (bus.drivers || []).forEach(name => {
                        const clean = String(name || '').replace('(S)', '').trim();
                        if (clean && !names.includes(clean)) names.push(clean);
                    });
                });
            });
            (appData.spares || []).forEach(name => {
                const clean = String(name || '').replace('(S)', '').trim();
                if (clean && !names.includes(clean)) names.push(clean);
            });

            const rows = {};
            names.forEach(name => {
                rows[name] = Array.from({length: totalDays}, () => ({m:false, a:false}));
            });

