        /* 스페어 기사 이름 전체 적용: 현재 화면에 표시되는 모든 텍스트에서 스페어 이름을 찾아
           파란색 + 밑줄로 표시합니다. (입력값/스크립트/스타일 영역은 제외) */
        function applySpareDriverGlobalStyle() {
            const spareNames = [...new Set((appData.spares || [])
                .map(s => s.replace('(S)', '').trim())
                .filter(Boolean))].sort((a, b) => b.length - a.length);
            if (!spareNames.length) return;

            const root = document.getElementById('app') || document.body;
            const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT);
            const nodes = [];
            let node;
            while ((node = walker.nextNode())) {
                const parent = node.parentElement;
                if (!parent || /^(SCRIPT|STYLE|TEXTAREA|INPUT|OPTION)$/.test(parent.tagName)) continue;
                if (parent.closest('.spare-driver-global')) continue;
                if (!spareNames.some(name => node.nodeValue.includes(name))) continue;
                nodes.push(node);
            }

            nodes.forEach(textNode => {
                const text = textNode.nodeValue;
                const pattern = spareNames.map(name => name.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')).join('|');
                if (!pattern) return;
                const re = new RegExp(pattern, 'g');
                const frag = document.createDocumentFragment();
                let last = 0, match;
                while ((match = re.exec(text)) !== null) {
                    if (match.index > last) frag.appendChild(document.createTextNode(text.slice(last, match.index)));
                    const span = document.createElement('span');
                    span.className = 'spare-driver-global';
                    span.textContent = match[0];
                    frag.appendChild(span);
                    last = match.index + match[0].length;
                }
                if (last < text.length) frag.appendChild(document.createTextNode(text.slice(last)));
                textNode.parentNode.replaceChild(frag, textNode);
            });
        }

