                    <div style="padding:0 18px 18px;display:flex;gap:10px;">
                        <button type="button" id="txtDeleteCancel" style="flex:1;padding:12px;border:1px solid #cbd5e1;background:#fff;color:#334155;border-radius:10px;font-weight:700;cursor:pointer;">취소</button>
                        <button type="button" id="txtDeleteConfirm" style="flex:1;padding:12px;border:0;background:#dc2626;color:#fff;border-radius:10px;font-weight:700;cursor:pointer;">삭제하기</button>
                    </div>
                </div>`;
            document.body.appendChild(win);

            const close = () => win.remove();
            document.getElementById('txtDeleteClose').onclick = close;
            document.getElementById('txtDeleteCancel').onclick = close;
            document.getElementById('txtDeleteConfirm').onclick = () => {
                const y = Number(document.getElementById('txtDeleteYear').value);
                const m = Number(document.getElementById('txtDeleteMonth').value);
                close();
                deleteSavedTxtFiles(y, m);
            };
        }

        // 현재 선택된 월의 "대호_배차변경_" TXT 파일만 삭제합니다.
        // 예: 2026년 9월 선택 → 대호_배차변경_2026-09-...txt 만 삭제
        // 안드로이드/PC 기준 폴더는 다운로드(Downloads) 폴더입니다.
        async function deleteSavedTxtFiles(selectedYear = currentYear, selectedMonth = currentMonth) {
            try {
                if (!('showDirectoryPicker' in window) || !window.isSecureContext) {
                    showModal('삭제 안내', '이 기기/브라우저에서는 폴더의 파일을 직접 삭제할 수 없습니다.\n파일 앱(또는 탐색기)에서 다운로드(Downloads) 폴더의 해당 월 TXT 파일을 삭제해 주세요.', true);
                    return;
                }

                const mmStr = String(selectedMonth).padStart(2, '0');
                const monthPrefix = `대호_배차변경_${selectedYear}-${mmStr}`;

                const dirHandle = await window.showDirectoryPicker({ mode: 'readwrite' });
                // 다운로드 폴더를 선택해 주세요. (폴더 이름은 기기/언어에 따라 Download, Downloads, 다운로드 등일 수 있습니다)
                const dirName = (dirHandle && dirHandle.name) ? dirHandle.name.toLowerCase() : '';
                const isDownloadsLike = /download|다운로드/.test(dirName);
                if (!isDownloadsLike) {
                    showModal('폴더 확인', '다운로드(Downloads) 폴더를 선택해 주세요.\n(선택한 폴더: ' + (dirHandle.name || '') + ')', true);
                    return;
                }

                let count = 0;
                for await (const entry of dirHandle.values()) {
                    if (entry.kind === 'file' &&
                        entry.name.toLowerCase().endsWith('.txt') &&
                        entry.name.startsWith(monthPrefix)) {
                        await dirHandle.removeEntry(entry.name);
                        count++;
                    }
                }

                showModal('삭제 완료', count
                    ? `${selectedYear}년 ${selectedMonth}월의 TXT 파일 ${count}개를 삭제했습니다.`
                    : `${selectedYear}년 ${selectedMonth}월의 '대호_배차변경_' TXT 파일이 없습니다.`);
            } catch (err) {
                if (err && err.name === 'AbortError') return;
                console.error('TXT 파일 삭제 오류:', err);
                showModal('삭제 오류', 'TXT 파일 삭제 중 문제가 발생했습니다: ' + (err.message || err), true);
            }
        }

        /**
         * 현재 화면의 노선/차량/스페어/휴무 데이터를
         * 불러오기와 동일한 TXT 형식으로 저장합니다.
         * (월간 배차 현황 주별통합 탭의 「TXT파일로 저장」 버튼)
         */
        async function exportCurrentDataToTxt() {
            try {
                const lines = [];
                const yyStr = String(currentYear).substring(2);
                const mStr = String(currentMonth).padStart(2, '0');

                // 노선·차량·기사: 원래 차량/기사 순서를 그대로 저장합니다.
                Object.keys(appData.routes || {}).forEach(routeName => {
                    lines.push(`[${routeName}]`);
                    (appData.routes[routeName] || []).forEach(bus => {
                        const drivers = (bus.drivers || [])
                            .map(n => String(n || '').replace('(S)', '').trim())
                            .filter(Boolean)
                            .join(', ');
                        lines.push(`${bus.busNo}: ${drivers}`);
                    });
                    lines.push('');
                });

                // 스페어
                lines.push('[스페어]');
                const spareNames = (appData.spares || [])
                    .map(n => String(n || '').replace('(S)', '').trim())
                    .filter(Boolean)
                    .join(', ');
                lines.push(spareNames);
                lines.push('');

                // 일자별 휴무 명단
                lines.push('직원 일자별 휴일자 명단');
                const totalDays = getDaysInMonth(currentYear, currentMonth);
                for (let d = 1; d <= totalDays; d++) {
                    const dayStr = String(d).padStart(2, '0');
                    const dateKey = `${yyStr}-${mStr}-${dayStr}`;
                    let offList = manualOffDisplayOverrides[dateKey]
                        ? [...manualOffDisplayOverrides[dateKey]]
                        : [...(appData.offDays[dateKey] || [])];
                    const names = offList
                        .map(n => String(n || '').replace('(S)', '').trim())
                        .filter(n => n && n !== '운행종료' && n !== '운행종료')
                        .join(',');
                    lines.push(`${dateKey}: ${names}`);
                }

                // ★ 최종 배차현황을 저장합니다.
                // 날짜 → 노선 → 차량 순서, 그리고 오전 → 오후 순서를 화면과 동일하게 유지합니다.
                // 변경된 배차뿐 아니라 모든 차량의 최종 배차를 저장하여,
                // TXT 재불러오기 후 자동 계산으로 원상복귀되는 것을 방지합니다.
                lines.push('');
                lines.push('[배차현황]');
                for (let d = 1; d <= totalDays; d++) {
                    const dayStr = String(d).padStart(2, '0');
                    const dateKey = `${yyStr}-${mStr}-${dayStr}`;
                    const dayData = getDailyAssignment(dateKey);
                    Object.keys(appData.routes || {}).forEach(routeName => {
                        (appData.routes[routeName] || []).forEach(bus => {
                            const assigned = (dayData.busAssignments || []).find(b =>
                                b.line === routeName && b.busNo === bus.busNo
                            );
                            if (!assigned) return;
                            const morning = String(assigned.morningAssigned || '미정').replace('(S)', '').trim();
                            const afternoon = String(assigned.afternoonAssigned || '미정').replace('(S)', '').trim();
                            lines.push(`${dateKey}|${routeName}|${bus.busNo}|오전: ${morning}|오후: ${afternoon}`);
                        });
                    });
                }

                // ★ 기사변경으로 바뀐 휴무자 표시도 저장합니다.
                lines.push('');
                lines.push('[수동휴무표시]');
                for (let d = 1; d <= totalDays; d++) {
                    const dayStr = String(d).padStart(2, '0');
                    const dateKey = `${yyStr}-${mStr}-${dayStr}`;
                    if (!Object.prototype.hasOwnProperty.call(manualOffDisplayOverrides, dateKey)) continue;
                    const names = (manualOffDisplayOverrides[dateKey] || [])
                        .map(n => String(n || '').replace('(S)', '').trim())
                        .filter(n => n && n !== '운행종료' && n !== '운행종료')
                        .join(',');
                    lines.push(`${dateKey}: ${names}`);
                }

                const content = lines.join('\n');
                const blob = new Blob([content], { type: 'application/octet-stream' });

                // TXT 전용 저장: 이미지 저장/공유 함수(downloadFile)를 사용하지 않습니다.
                // 따라서 iPhone 공유 메뉴에서 별도의 text.txt가 만들어지는 현상을 방지합니다.
                const now = new Date();
                const pad2 = n => String(n).padStart(2, '0');
                const timestamp = `${now.getFullYear()}-${pad2(now.getMonth() + 1)}-${pad2(now.getDate())}_${pad2(now.getHours())}시${pad2(now.getMinutes())}분${pad2(now.getSeconds())}초`;
                const fileName = `대호_배차변경_${timestamp}.txt`;

                // iPhone/iPad: 파일만 공유합니다. (원하는 폴더에 저장)
                const file = new File([blob], fileName, { type: 'text/plain' });
                if (/iphone|ipad|ipod/i.test(navigator.userAgent || '') && navigator.share && navigator.canShare && navigator.canShare({ files: [file] })) {
                    try {
                        await navigator.share({ files: [file] });
                        return;
                    } catch (err) {
                        if (err && err.name === 'AbortError') return;
                        console.warn('iOS 파일 공유 실패 → 일반 다운로드로 전환:', err);
                    }
                }

                // 안드로이드 / PC: 항상 다운로드(Downloads) 폴더로 저장합니다. (daeho 폴더 사용 안 함)
                const url = URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                a.download = fileName;
                a.setAttribute('download', fileName);
                a.style.display = 'none';
                document.body.appendChild(a);
                a.click();
                a.remove();
                setTimeout(() => URL.revokeObjectURL(url), 1000);
                showModal('저장 완료', `"${fileName}" 파일을 다운로드 폴더에 저장했습니다.`);
            } catch (err) {
                console.error('TXT 저장 오류:', err);
                showModal('오류', 'TXT 파일 저장 중 문제가 발생했습니다: ' + (err.message || err), true);
            }
        }

        function exportToExcelAllTabs() {
            const wb = XLSX.utils.book_new();
            const totalDays = getDaysInMonth(currentYear, currentMonth);
            const yyStr = String(currentYear).substring(2);
            const mStr = currentMonth < 10 ? `0${currentMonth}` : `${currentMonth}`;

            // 1. 월간 종합 매트릭스
            let matrixHeaders = ["노선", "차량"];
            for (let d = 1; d <= totalDays; d++) {
                matrixHeaders.push(`${currentMonth}월 ${d}일(${getDayOfWeekStr(currentYear, currentMonth, d)}) 오전`, `${currentMonth}월 ${d}일(${getDayOfWeekStr(currentYear, currentMonth, d)}) 오후`);
            }
            let matrixRows = [];
            Object.keys(appData.routes).forEach(r => {
                appData.routes[r].forEach(b => {
                    let rowData = [r, b.busNo];
                    for (let d = 1; d <= totalDays; d++) {
                        let dStr = d < 10 ? `0${d}` : `${d}`;
                        let dateKey = `${yyStr}-${mStr}-${dStr}`;
                        let dayAssign = getDailyAssignment(dateKey);
                        let bMatch = dayAssign.busAssignments.find(item => item.line === r && item.busNo === b.busNo);
                        if (bMatch) {
                            rowData.push(bMatch.morningAssigned.replace('(S)', ''), bMatch.afternoonAssigned.replace('(S)', ''));
                        } else {
                            rowData.push("-", "-");
                        }
                    }
                    matrixRows.push(rowData);
                });
            });
            XLSX.utils.book_append_sheet(wb, XLSX.utils.aoa_to_sheet([matrixHeaders, ...matrixRows]), "월간종합배차표");

            // 2. 일일배차 상세 목록
            let dailyListRows = [["날짜", "요일", "노선", "차량", "오전근무", "오후근무", "휴무자명단"]];
            for (let d = 1; d <= totalDays; d++) {
                let dStr = d < 10 ? `0${d}` : `${d}`;
                let dateKey = `${yyStr}-${mStr}-${dStr}`;
                let dow = getDayOfWeekStr(currentYear, currentMonth, d);
                let dayAssign = getDailyAssignment(dateKey);
                let offStr = dayAssign.offList.map(n => n.replace('(S)', '')).join(', ');

                dayAssign.busAssignments.forEach((item, idx) => {
                    dailyListRows.push([
                        `${currentMonth}월 ${d}일`,
                        dow,
                        item.line,
                        item.busNo,
                        item.morningAssigned.replace('(S)', ''),
                        item.afternoonAssigned.replace('(S)', ''),
                        idx === 0 ? offStr : ""
                    ]);
                });
            }
            XLSX.utils.book_append_sheet(wb, XLSX.utils.aoa_to_sheet(dailyListRows), "일일배차목록");

            // 3. 월간 휴무 현황표
            let offTableHeaders = ["기사명", "총휴무일수"];
            for (let d = 1; d <= totalDays; d++) {
                offTableHeaders.push(`${currentMonth}.${d}(${getDayOfWeekStr(currentYear, currentMonth, d)})`);
            }
            let offTableRows = [];
            let allDriversList = [];
            Object.keys(appData.routes).forEach(r => appData.routes[r].forEach(b => b.drivers.forEach(d => allDriversList.push(d))));
            appData.spares.forEach(s => allDriversList.push(s));

            allDriversList.forEach(drvName => {
                let cleanName = drvName.replace('(S)', '').trim();
                let row = [cleanName];
                let offCount = 0;
                let dayStatuses = [];
                for (let d = 1; d <= totalDays; d++) {
                    let dStr = d < 10 ? `0${d}` : `${d}`;
                    let dateKey = `${yyStr}-${mStr}-${dStr}`;
                    let isOff = getDailyAssignment(dateKey).offList.includes(cleanName);
                    if (isOff) {
                        offCount++;
                        dayStatuses.push("휴무");
                    } else {
                        dayStatuses.push("근무");
                    }
                }
                row.push(offCount);
                row.push(...dayStatuses);
                offTableRows.push(row);
            });
            XLSX.utils.book_append_sheet(wb, XLSX.utils.aoa_to_sheet([offTableHeaders, ...offTableRows]), "월간휴무현황표");

            // 4. 월간 휴무 대장
            let offLedgerRows = [["날짜", "휴무인원수", "휴무자 명단"]];
            for (let d = 1; d <= totalDays; d++) {
                let dStr = d < 10 ? `0${d}` : `${d}`;
                let dateKey = `${yyStr}-${mStr}-${dStr}`;
                let offList = getDailyAssignment(dateKey).offList.map(n => n.replace('(S)', '')).filter(Boolean);
                offLedgerRows.push([
                    `${currentMonth}월 ${d}일 (${getDayOfWeekStr(currentYear, currentMonth, d)})`,
                    offList.length + "명",
                    offList.join(", ")
                ]);
            }
            XLSX.utils.book_append_sheet(wb, XLSX.utils.aoa_to_sheet(offLedgerRows), "월간 휴무 대장");

            // 5. 기사별 근무 통계
            let simCache = runMonthlySpareSimulation();
            let driverMap = {};
            Object.keys(appData.routes).forEach(r => appData.routes[r].forEach(b => b.drivers.forEach(d => {
                let cn = d.replace('(S)', '').trim();
                driverMap[cn] = { name: cn, type: '정규기사', spareWorkDays: 0, offCount: 0 };
            })));
            appData.spares.forEach(s => {
                let cn = s.replace('(S)', '').trim();
                driverMap[cn] = { name: cn, type: '스페어', spareWorkDays: 0, offCount: 0 };
            });

            for (let d = 1; d <= totalDays; d++) {
                let dStr = d < 10 ? `0${d}` : `${d}`;
                let dateKey = `${yyStr}-${mStr}-${dStr}`;
                if (simCache[dateKey]?.assignedSpares) {
                    simCache[dateKey].assignedSpares.forEach(i => {
                        let cn = i.spare.replace('(S)', '').trim();
                        if (driverMap[cn]) driverMap[cn].spareWorkDays++;
                    });
                }
            }

            let driverStatRows = [["기사명", "구분", "총 근무일수", "총 휴무일수"]];
            Object.values(driverMap).forEach(drv => {
                let offC = 0;
                if (drv.type === '스페어') {
                    offC = totalDays - drv.spareWorkDays;
                } else {
                    let count = 0;
                    for (let d = 1; d <= totalDays; d++) {
                        let dStr = d < 10 ? `0${d}` : `${d}`;
                        let dateKey = `${yyStr}-${mStr}-${dStr}`;
                        if (getDailyAssignment(dateKey).offList.includes(drv.name)) count++;
                    }
                    offC = count;
                }
                let workC = totalDays - offC;
                driverStatRows.push([drv.name, drv.type, workC, offC]);
            });
            XLSX.utils.book_append_sheet(wb, XLSX.utils.aoa_to_sheet(driverStatRows), "기사별 근무 통계");

            // 6. 노선 및 차량 정보
            let infoRows = [["구분", "노선/분류", "차량", "배정 기사"]];
            Object.keys(appData.routes).forEach(r => {
                appData.routes[r].forEach(b => {
                    infoRows.push(["정규노선", r, b.busNo, `오전: ${b.drivers[0].replace('(S)','')}, 오후: ${b.drivers[1].replace('(S)','')}`]);
                });
            });
            appData.spares.forEach(s => {
                infoRows.push(["스페어기사", "Sch", "-", s.replace('(S)','')]);
            });
            XLSX.utils.book_append_sheet(wb, XLSX.utils.aoa_to_sheet(infoRows), "노선 및 차량 정보");

            const buf = XLSX.write(wb, { bookType: 'xlsx', type: 'array' });
            const blob = new Blob([buf], { type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' });
            downloadFile(blob, `대호교통_전체배차및휴무통계_${currentYear}년_${currentMonth}월.xlsx`);
        }

        async function exportToImage() {
            const active = document.querySelector('.tab-content:not(.hidden)');
            if (!active) {
                showModal("오류", "활성화된 탭 영역을 찾을 수 없습니다.", true);
                return;
            }
            if (typeof html2canvas === 'undefined') {
                showModal("오류", "이미지 저장 모듈(html2canvas)을 불러오지 못했습니다.", true);
                return;
            }

            let captureWrap = null;
            try {
                const isOffDays = active.id === 'view-offdays';
                let imageTarget;
                let targetWidth = 0;

                if (isOffDays) {
                    /*
                     * 월간 휴무 대장은 화면의 2열 전체가 아니라
                     * 왼쪽 '달력' 영역만 이미지로 만듭니다.
                     *
                     * 중요: imageTarget은 새로 만든 DOM이라 처음에는 DOM에 붙어 있지 않아
                     * clientWidth/scrollWidth가 0입니다. 기존 코드에서는 이 값을 먼저 읽어
                     * width=0이 되면서 html2canvas가 0x0 캔버스를 만들고 실패했습니다.
                     * 따라서 원본 달력 열의 실제 폭을 먼저 확보한 뒤 붙입니다.
                     */
                    const calendarGrid = active.querySelector('#calendarGrid');
                    const calendarColumn = calendarGrid ? calendarGrid.parentElement : null;
                    if (!calendarColumn) {
                        throw new Error('휴무대장 달력 영역을 찾을 수 없습니다.');
                    }

                    const originalRect = calendarColumn.getBoundingClientRect();
                    const measuredWidth = Math.ceil(originalRect.width || calendarColumn.offsetWidth || 0);
                    // 이미지에서는 모바일 화면 폭에 맞춰 축소하지 않고,
                    // 7개 칸에 충분한 폭을 확보하여 기사명이 잘리지 않도록 합니다.
                    targetWidth = Math.max(760, measuredWidth, 320);

                    imageTarget = document.createElement('div');
                    imageTarget.className = 'offdays-image-export';
                    imageTarget.style.width = targetWidth + 'px';
                    imageTarget.style.maxWidth = 'none';
                    imageTarget.style.background = '#ffffff';
                    imageTarget.style.boxSizing = 'border-box';
                    imageTarget.style.padding = '0';
                    imageTarget.style.margin = '0';

                    const title = document.createElement('div');
                    title.textContent = `${currentYear}년 ${String(currentMonth).padStart(2, '0')}월 휴무대장`;
                    title.style.fontSize = '28px';
                    title.style.fontWeight = '900';
                    title.style.letterSpacing = '-0.03em';
                    title.style.textAlign = 'center';
                    title.style.padding = '18px 12px 7px';
                    title.style.color = '#0f172a';
                    title.style.background = 'linear-gradient(180deg,#ffffff 0%,#f8fafc 100%)';
                    title.style.border = '1px solid #cbd5e1';
                    title.style.borderBottom = '0';
                    title.style.borderRadius = '18px 18px 0 0';
                    title.style.boxSizing = 'border-box';
                    imageTarget.appendChild(title);

                    const subtitle = document.createElement('div');
                    subtitle.textContent = '일자별 휴무 현황';
                    subtitle.style.textAlign = 'center';
                    subtitle.style.fontSize = '13px';
                    subtitle.style.fontWeight = '700';
                    subtitle.style.color = '#64748b';
                    subtitle.style.padding = '0 12px 14px';
                    subtitle.style.background = '#f8fafc';
                    imageTarget.appendChild(subtitle);

                    const calendarClone = calendarColumn.cloneNode(true);
                    calendarClone.style.width = '100%';
                    calendarClone.style.maxWidth = 'none';
                    calendarClone.style.margin = '0';
                    calendarClone.style.boxSizing = 'border-box';
                    calendarClone.style.background = '#ffffff';
                    calendarClone.style.display = 'block';
                    imageTarget.appendChild(calendarClone);
                    calendarClone.style.background = '#ffffff';
                    calendarClone.style.padding = '0 8px 8px';
                    calendarClone.style.border = '1px solid #cbd5e1';
                    calendarClone.style.borderTop = '0';
                    calendarClone.style.borderRadius = '0 0 18px 18px';
                    calendarClone.querySelectorAll('#calendarGrid > div').forEach(cell => {
                        cell.style.minHeight = '118px';
                        cell.style.padding = '9px 7px';
                        cell.style.borderRadius = '11px';
                        cell.style.boxShadow = '0 2px 8px rgba(15,23,42,.08)';
                    });
                    /* 휴무자 이름을 이미지에서 확실히 구분되도록 사람별 배지로 표시합니다. */
                    const namePalette = [
                        ['#eff6ff','#1d4ed8','#bfdbfe'],
                        ['#fef2f2','#b91c1c','#fecaca'],
                        ['#f0fdf4','#15803d','#bbf7d0'],
                        ['#fffbeb','#b45309','#fde68a'],
                        ['#faf5ff','#7e22ce','#e9d5ff'],
                        ['#f0fdfa','#0f766e','#99f6e4'],
                        ['#fff7ed','#c2410c','#fed7aa'],
                        ['#fdf2f8','#be185d','#fbcfe8']
                    ];
                    const nameColorIndex = new Map();
                    let nextNameColor = 0;
                    calendarClone.querySelectorAll('#calendarGrid > div > div:last-child span').forEach(span => {
                        const name = span.textContent.trim();
                        if (!name || name === '-') return;
                        if (!nameColorIndex.has(name)) {
                            nameColorIndex.set(name, nextNameColor++ % namePalette.length);
                        }
                        const [bg, fg, border] = namePalette[nameColorIndex.get(name)];
                        span.style.display = 'block';
                        span.style.boxSizing = 'border-box';
                        span.style.width = 'calc(100% - 4px)';
                        span.style.margin = '1px 2px';
                        span.style.padding = '3px 5px';
                        span.style.borderRadius = '6px';
                        span.style.background = bg;
                        span.style.color = fg;
                        span.style.border = '1px solid ' + border;
                        span.style.fontWeight = '900';
                        span.style.fontSize = '12px';
                        span.style.lineHeight = '1.2';
                        span.style.textAlign = 'center';
                        span.style.whiteSpace = 'normal';
                        span.style.overflow = 'visible';
                        span.style.textOverflow = 'clip';
                        span.style.overflowWrap = 'anywhere';
                    });

                    /* 날짜별 휴무자 수를 더 눈에 띄게 표시합니다. */
                    calendarClone.querySelectorAll('#calendarGrid > div > div:first-child span:last-child').forEach(count => {
                        count.style.background = '#e0f2fe';
                        count.style.color = '#0369a1';
                        count.style.border = '1px solid #bae6fd';
                        count.style.fontWeight = '900';
                        count.style.padding = '3px 7px';
                    });

                    // 원본 ID 중복을 피합니다.
                    calendarClone.querySelectorAll('#calendarGrid').forEach(grid => {
                        grid.removeAttribute('id');
                        grid.style.borderRadius = '0 0 10px 10px';
                    });
                    const dayHeader = calendarClone.querySelector('.grid.grid-cols-7');
                    if (dayHeader) {
                        dayHeader.style.borderRadius = '0';
                    }

                } else if (active.id === 'view-weekly') {
                    // 월간 배차현황(주별통합)은 화면의 가로형 테이블을 그대로 캡처하지 않고
                    // 날짜별 7열 달력으로 재구성하여 이미지로 저장합니다.
                    const totalDays = getDaysInMonth(currentYear, currentMonth);
                    targetWidth = 1500;
                    imageTarget = document.createElement('div');
                    imageTarget.style.width = targetWidth + 'px';
                    imageTarget.style.background = '#ffffff';
                    imageTarget.style.boxSizing = 'border-box';
                    imageTarget.style.padding = '18px';
                    imageTarget.style.fontFamily = 'Arial, sans-serif';

                    const esc = v => String(v ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/\"/g,'&quot;');
                    const title = document.createElement('div');
                    title.innerHTML = `<div style="font-size:34px;font-weight:900;text-align:center;color:#0f172a;margin-bottom:6px;">${currentYear}년 ${currentMonth}월 월간 배차현황</div>
                                       <div style="font-size:18px;font-weight:700;text-align:center;color:#64748b;margin-bottom:18px;">주별통합 · 날짜별 달력형식</div>`;
                    imageTarget.appendChild(title);

                    const grid = document.createElement('div');
                    grid.style.display = 'grid';
                    grid.style.gridTemplateColumns = 'repeat(7, 1fr)';
                    grid.style.gap = '7px';

                    // 요일 헤더
                    ['일','월','화','수','목','금','토'].forEach((dow, i) => {
                        const h = document.createElement('div');
                        h.textContent = dow;
                        h.style.textAlign = 'center';
                        h.style.fontWeight = '900';
                        h.style.fontSize = '18px';
                        h.style.padding = '10px 0';
                        h.style.background = '#e2e8f0';
                        h.style.border = '1px solid #cbd5e1';
                        h.style.borderRadius = '8px';
                        grid.appendChild(h);
                    });

                    const firstDow = new Date(currentYear, currentMonth - 1, 1).getDay();
                    for (let i = 0; i < firstDow; i++) {
                        const blank = document.createElement('div');
                        blank.style.minHeight = '195px';
                        blank.style.background = '#f8fafc';
                        blank.style.border = '1px solid #e2e8f0';
                        blank.style.borderRadius = '9px';
                        grid.appendChild(blank);
                    }

                    let allBuses = [];
                    Object.keys(appData.routes).forEach(r => appData.routes[r].forEach(b => allBuses.push({line:r,busNo:b.busNo})));

                    for (let d = 1; d <= totalDays; d++) {
                        const dateKey = `${String(currentYear).substring(2)}-${String(currentMonth).padStart(2,'0')}-${String(d).padStart(2,'0')}`;
                        const dayData = getDailyAssignment(dateKey);
                        const dow = new Date(currentYear, currentMonth - 1, d).getDay();
                        const cell = document.createElement('div');
                        cell.style.minHeight = '225px';
                        cell.style.background = '#ffffff';
                        cell.style.border = '1px solid #cbd5e1';
                        cell.style.borderRadius = '9px';
                        cell.style.overflow = 'hidden';
                        cell.style.boxSizing = 'border-box';

                        const offNames = (dayData.offList || []).map(name => String(name || '').replace('(S)','').trim()).filter(Boolean);
                        const offText = offNames.length ? offNames.join(', ') : '-';
                        let html = `<div style="padding:7px 8px 4px;background:#f1f5f9;border-bottom:1px solid #cbd5e1;font-weight:900;font-size:17px;">${currentMonth}월 ${d}일 <span style="font-size:14px;color:${dow===0?'#dc2626':dow===6?'#2563eb':'#475569'};">(${['일','월','화','수','목','금','토'][dow]})</span></div>`;
                        html += `<div style="padding:3px 7px 5px;background:#f0fdf4;border-bottom:1px solid #bbf7d0;font-size:12px;line-height:1.35;text-align:left;"><span style="font-weight:900;color:#15803d;">휴무:</span> <span style="font-weight:700;color:#16a34a;">${esc(offText)}</span></div>`;
                        html += `<div style="padding:5px 6px 2px;">`;
                        allBuses.forEach(bus => {
                            const b = (dayData.busAssignments || []).find(x => x.line === bus.line && x.busNo === bus.busNo);
                            const m = b ? String(b.morningAssigned || '-').replace('(S)','').trim() : '-';
                            const a = b ? String(b.afternoonAssigned || '-').replace('(S)','').trim() : '-';
                            const mSpare = b && appData.spares.some(x => x.replace('(S)','').trim() === m);
                            const aSpare = b && appData.spares.some(x => x.replace('(S)','').trim() === a);
                            html += `<div style="display:grid;grid-template-columns:65px 1fr 1fr;gap:3px;align-items:center;font-size:12px;line-height:1.35;border-bottom:1px solid #f1f5f9;padding:2px 0;">` +
                                     `<b style="text-align:center;color:#334155;">${esc(bus.line.replace('번',''))}-${esc(bus.busNo)}</b>` +
                                     `<span style="text-align:center;font-weight:800;color:${m==='운행종료'?'#dc2626':(mSpare?'#2563eb':'#0f172a')};text-decoration:${mSpare && m!=='운행종료'?'underline':'none'};">${esc(m)}</span>` +
                                     `<span style="text-align:center;font-weight:800;color:${a==='운행종료'?'#dc2626':(aSpare?'#2563eb':'#0f172a')};text-decoration:${aSpare && a!=='운행종료'?'underline':'none'};">${esc(a)}</span></div>`;
                        });
                        html += `</div>`;
                        cell.innerHTML = html;
                        grid.appendChild(cell);
                    }
                    imageTarget.appendChild(grid);

                    const legend = document.createElement('div');
                    legend.innerHTML = '<div style="margin-top:12px;text-align:center;font-size:14px;font-weight:700;color:#475569;">오전 / 오후 · <span style="color:#2563eb;text-decoration:underline;">파란 밑줄 = 스페어 대체기사</span></div>';
                    imageTarget.appendChild(legend);
                } else {
                    imageTarget = active;
                    targetWidth = Math.max(
                        active.scrollWidth || 0,
                        active.clientWidth || 0,
                        active.offsetWidth || 0,
                        ...Array.from(active.querySelectorAll('table')).map(t =>
                            Math.max(t.scrollWidth || 0, t.offsetWidth || 0)
                        )
                    );
                }

                /* 캡처용 DOM을 실제 문서에 붙인 뒤 크기를 측정합니다. */
                const capture = imageTarget.cloneNode(true);
                capture.classList.remove('hidden');
                capture.style.width = Math.max(1, targetWidth) + 'px';
                capture.style.maxWidth = 'none';
                capture.style.height = 'auto';
                capture.style.maxHeight = 'none';
                capture.style.overflow = 'visible';
                capture.style.margin = '0';
                capture.style.boxSizing = 'border-box';
                capture.style.position = 'static';
                capture.style.display = 'block';

                capture.querySelectorAll('.overflow-x-auto, .overflow-auto').forEach(el => {
                    el.style.overflow = 'visible';
                    el.style.width = '100%';
                    el.style.maxWidth = 'none';
                    el.style.maxHeight = 'none';
                });

                captureWrap = document.createElement('div');
                captureWrap.setAttribute('data-image-capture', 'true');
                captureWrap.style.position = 'absolute';
                captureWrap.style.left = '0';
                captureWrap.style.top = '0';
                captureWrap.style.width = Math.max(1, targetWidth) + 'px';
                captureWrap.style.background = '#ffffff';
                captureWrap.style.overflow = 'visible';
                captureWrap.style.zIndex = '-1';
                captureWrap.style.pointerEvents = 'none';
                captureWrap.appendChild(capture);
                document.body.appendChild(captureWrap);

                await new Promise(resolve => requestAnimationFrame(() =>
                    requestAnimationFrame(resolve)
                ));

                const rect = capture.getBoundingClientRect();
                const captureWidth = Math.ceil(Math.max(
                    1,
                    rect.width,
                    capture.scrollWidth || 0,
                    capture.offsetWidth || 0
                ));
                const captureHeight = Math.ceil(Math.max(
                    1,
                    rect.height,
                    capture.scrollHeight || 0,
                    capture.offsetHeight || 0
                ));

                /* iPhone Safari의 canvas 크기 제한을 고려해 안전한 배율을 계산합니다. */
                const maxCanvasSide = 8192;
                const maxCanvasArea = 26800000;
                const mobileWidth = Math.max(
                    320,
                    document.documentElement.clientWidth || window.innerWidth || 390
                );
                const fitScale = Math.min(1, mobileWidth / Math.max(1, captureWidth));
                const imageQualityScale = isOffDays ? 2.5 : 6;
                const renderScale = fitScale * imageQualityScale;

                let safeScale = Math.min(
                    renderScale,
                    maxCanvasSide / captureWidth,
                    maxCanvasSide / captureHeight,
                    Math.sqrt(maxCanvasArea / (captureWidth * captureHeight))
                );
                safeScale = Math.max(0.5, safeScale);

                const canvas = await html2canvas(capture, {
                    width: captureWidth,
                    height: captureHeight,
                    windowWidth: captureWidth,
                    windowHeight: captureHeight,
                    scale: safeScale,
                    useCORS: true,
                    allowTaint: false,
                    backgroundColor: '#ffffff',
                    logging: false,
                    scrollX: 0,
                    scrollY: 0,
                    imageTimeout: 15000,
                    removeContainer: true
                });

                if (!canvas || !canvas.width || !canvas.height) {
                    throw new Error('캔버스 생성에 실패했습니다.');
                }

                const saveBlob = (type, quality) => new Promise((resolve, reject) => {
                    canvas.toBlob(blob => {
                        if (blob) resolve(blob);
                        else reject(new Error('이미지 변환 실패'));
                    }, type, quality);
                });

                let blob, ext;
                try {
                    blob = await saveBlob('image/png');
                    ext = 'png';
                } catch (pngErr) {
                    blob = await saveBlob('image/jpeg', 0.98);
                    ext = 'jpg';
                }

                // 저장명: 대호_탭명_월 형식
                const tabNameMap = {
                    'view-daily': '일자별배차현황',
                    'view-weekly': '월간배차현황_주별통합',
                    'view-dailyList': '월간배차현황_일일배차',
                    'view-monthly': '월간배차현황_매트릭스',
                    'view-monthlyOff': '월간휴무현황표',
                    'view-offdays': '월간휴무대장',
                    'view-drivers': '기사별근무통계',
                    'view-driverGraph': '기사별근무일수그래프',
                    'view-info': '노선차량스페어정보'
                };
                const tabName = tabNameMap[active.id] || '배차현황';
                const filePrefix = `대호_${tabName}`;
                await downloadFile(blob, `${filePrefix}_${currentMonth}월.${ext}`);

            } catch (err) {
                console.error('이미지 저장 오류:', err);
                showModal("오류", "이미지 저장 중 문제가 발생했습니다: " + err.message, true);
            } finally {
                if (captureWrap && captureWrap.parentNode) {
                    captureWrap.parentNode.removeChild(captureWrap);
                }
            }
        }

    </script>
</body>
