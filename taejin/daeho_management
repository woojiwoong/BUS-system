                    if (name.includes('운행종료')) {
                        return `<span class="inline-flex items-center justify-center gap-1 bg-rose-600 text-white font-bold px-2.5 py-1 rounded-md text-xs shadow-xs"><i data-lucide="ban" class="w-3 h-3"></i>운행종료</span>`;
                    }
                    let cleanName = name.replace('(S)','').trim();
                    let isSpare = appData.spares.includes(cleanName);
                    if (isSpare) {
                        return `<span class="inline-flex items-center justify-center gap-1 font-bold text-blue-600 blue-underline"><i data-lucide="user-cog" class="w-3.5 h-3.5"></i>${cleanName}</span>`;
                    }
                    return `<span class="inline-flex items-center justify-center gap-1 font-bold text-slate-900"><i data-lucide="user" class="w-3.5 h-3.5 text-slate-500"></i>${cleanName}</span>`;
                }

                return `
                    <tr class="hover:bg-slate-50 transition-colors">
                        <td class="px-2 py-2.5 text-center font-extrabold ${lineTextColor} bg-slate-50/50 align-middle whitespace-nowrap">${item.line}</td>
                        <td class="px-2 py-2.5 text-center font-semibold text-slate-800 align-middle whitespace-nowrap">${item.busNo}</td>
                        <td class="px-3 py-2.5 text-center bg-amber-50/20 cursor-pointer hover:bg-amber-100/40 align-middle" onclick="openDriverSelectModal('${dateInput.substring(2)}', '${item.line}', '${item.busNo}', 'morning', '${item.morningAssigned.replace('(S)','')} ')">
                            ${formatDailyCell(item.morningAssigned)}
                        </td>
                        <td class="px-3 py-2.5 text-center bg-indigo-50/20 cursor-pointer hover:bg-indigo-100/40 align-middle" onclick="openDriverSelectModal('${dateInput.substring(2)}', '${item.line}', '${item.busNo}', 'afternoon', '${item.afternoonAssigned.replace('(S)','')} ')">
                            ${formatDailyCell(item.afternoonAssigned)}
                        </td>
                    </tr>
                `;
            }).join('');

            if (window.lucide) lucide.createIcons();
        }

